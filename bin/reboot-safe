#!/usr/bin/env bash
# reboot-safe —— 卡死时安全重启：采集诊断 → 保存数据 → 干净重启；systemd 卡住则走内核级硬重启
#
# 用法（在 TTY 里）：
#   freeze              # = sudo ~/.local/bin/reboot-safe，已配免密码
#   reboot-safe --dry   # 只打印会做什么，不真重启（测试用）
#
# 重启前会把诊断信息存到 ~/.cache/freeze/crash-context.txt，
# 重启后由 freeze-report 读取并弹桌面通知复盘（见 bin/freeze-report）。
set -u

if [[ "${1:-}" == "--dry" ]]; then
  echo "===== 卡死安全重启（演练，不真执行）====="
  echo "[1/4] 会执行：采集诊断 → ~/.cache/freeze/crash-context.txt"
  echo "[2/4] 会执行：sync              （保存数据）"
  echo "[3/4] 会执行：systemctl reboot  （干净重启，5 秒没反应就跳过）"
  echo "[4/4] 备用：  remount ro + SysRq-b（内核级硬重启，作为最后手段）"
  exit 0
fi

echo "================ 卡死安全重启 ================"

echo "[1/4] 采集诊断信息，供重启后复盘 ..."
# 脚本以 root 运行，HOME 不是用户家目录；用 SUDO_USER 反查真实家目录
if [[ -n "${SUDO_USER:-}" ]]; then
  user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
else
  user_home="$HOME"
fi
cache_dir="$user_home/.cache/freeze"
ctx="$cache_dir/crash-context.txt"
mkdir -p "$cache_dir"
{
  echo "===== freeze 安全重启诊断信息 ====="
  echo "时间: $(date '+%F %T')"
  echo "开机时长: $(uptime -p)"
  echo
  echo "--- 本开机错误日志 (journalctl -p 3) ---"
  journalctl -b -0 -p 3 --no-pager 2>/dev/null | tail -30
  echo
  echo "--- 显卡/内核相关 (xid|nvidia|hang|gpu|drm|i915) ---"
  journalctl -b -0 -k --no-pager 2>/dev/null | grep -iE 'xid|nvidia|hang|gpu|drm|i915' | tail -20
  echo
  echo "--- picom 日志最后 20 行 ---"
  tail -20 /tmp/picom.log 2>/dev/null || echo "(无 /tmp/picom.log)"
} > "$ctx"
# 脚本以 root 运行，但 freeze-report 以普通用户身份读/删该文件；
# 把目录属主还给用户，避免 root 建的目录用户无权访问
chown -R "${SUDO_USER:-}" "$cache_dir" 2>/dev/null || true
echo "      已保存到 $ctx"

echo "[2/4] 保存数据 (sync) ..."
sync
echo "      完成。"

echo "[3/4] 尝试干净重启 (systemctl reboot) ..."
if timeout 5 systemctl reboot; then
  # systemctl 已触发关机，机器马上重启，这里永远不会执行到
  exit 0
fi

echo "      systemd 没响应（可能卡住了），改用紧急路径。"
echo "      -> 把磁盘设为只读，防止重启过程写坏 ..."
mount -o remount,ro / 2>/dev/null || echo "      (磁盘忙，未能设只读，继续)"
sync

echo "[4/4] 内核级硬重启 (SysRq-b) ..."
echo b > /proc/sysrq-trigger

# 理论上到不了这里；万一到了，提示手动兜底
echo "!!! 内核级重启也未生效，请长按电源键 10 秒。"
exit 1
