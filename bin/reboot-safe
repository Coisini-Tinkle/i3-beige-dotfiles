#!/usr/bin/env bash
# reboot-safe —— 卡死时安全重启：保存数据 → 干净重启；systemd 卡住则走内核级硬重启
#
# 用法（在 TTY 里）：
#   freeze              # = sudo ~/.local/bin/reboot-safe，已配免密码
#   reboot-safe --dry   # 只打印会做什么，不真重启（测试用）
set -u

if [[ "${1:-}" == "--dry" ]]; then
  echo "===== 卡死安全重启（演练，不真执行）====="
  echo "[1/3] 会执行：sync              （保存数据）"
  echo "[2/3] 会执行：systemctl reboot  （干净重启，5 秒没反应就跳过）"
  echo "[3/3] 备用：  remount ro + SysRq-b（内核级硬重启，作为最后手段）"
  exit 0
fi

echo "================ 卡死安全重启 ================"

echo "[1/3] 保存数据 (sync) ..."
sync
echo "      完成。"

echo "[2/3] 尝试干净重启 (systemctl reboot) ..."
if timeout 5 systemctl reboot; then
  # systemctl 已触发关机，机器马上重启，这里永远不会执行到
  exit 0
fi

echo "      systemd 没响应（可能卡住了），改用紧急路径。"
echo "      -> 把磁盘设为只读，防止重启过程写坏 ..."
mount -o remount,ro / 2>/dev/null || echo "      (磁盘忙，未能设只读，继续)"
sync

echo "[3/3] 内核级硬重启 (SysRq-b) ..."
echo b > /proc/sysrq-trigger

# 理论上到不了这里；万一到了，提示手动兜底
echo "!!! 内核级重启也未生效，请长按电源键 10 秒。"
exit 1
