# Minimal i3 config aligned with kitty/zsh theme.

set $mod Mod4
set $terminal ~/.config/kitty/kitty-random.sh
set $launcher rofi -show drun
set $left h
set $down j
set $up k
set $right semicolon

font pango:JetBrainsMono Nerd Font Mono 11

focus_follows_mouse no
focus_on_window_activation urgent
mouse_warping none
floating_modifier $mod
workspace_auto_back_and_forth no

default_border pixel 3
default_floating_border pixel 3
hide_edge_borders smart
gaps inner 10
gaps outer 4
smart_gaps on
for_window [class="^Rofi$"] border pixel 0
for_window [class="^ToDesk$"] floating enable, border pixel 0, sticky enable
for_window [class="^ToDesk$" title="^ToDesk$"] move scratchpad
for_window [class="^copyq$"] floating enable, border pixel 1, move position center, resize set 960 640
for_window [class="^kitty-float$"] floating enable, border pixel 1, move position center, resize set 960 640
for_window [class="^kitty-dropdown$"] floating enable, sticky enable, border pixel 1, move position center, resize set 1400 720
for_window [class="^notification-drop-panel$"] floating enable, sticky enable, border pixel 0

# Theme colors first — overridden below for focus visibility
include /home/coisini/.config/i3/themes/current/i3-colors.conf

client.focused          #4f8a82 #4f8a82 #f5ebe1 #4f8a82 #4f8a82
client.focused_inactive #dcd3ca #dcd3ca #1a1a1a #dcd3ca #dcd3ca
client.unfocused        #dcd3ca #dcd3ca #6a6258 #dcd3ca #dcd3ca
client.urgent           #ca7081 #ca7081 #f5ebe1 #ca7081 #ca7081
client.placeholder      #dcd3ca #dcd3ca #1a1a1a #dcd3ca #dcd3ca
client.background       #f5ebe1

set $ws1 "1:I"
set $ws2 "2:II"
set $ws3 "3:III"
set $ws4 "4:IV"
set $ws5 "5:V"
set $ws6 "6:VI"
set $ws7 "7:VII"
set $ws8 "8:VIII"
set $ws9 "9:IX"
set $ws10 "10:X"
include /home/coisini/.config/i3/display/routing.conf

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- bash /home/coisini/.config/i3/lock.sh
exec --no-startup-id sh -c 'pkill -x fcitx >/dev/null 2>&1 || true; fcitx5 -d -r'
exec --no-startup-id /usr/bin/flameshot
exec_always --no-startup-id sh -c 'command -v feh >/dev/null && feh --no-fehbg --bg-fill /home/coisini/.config/i3/themes/current/wallpaper.png'
exec_always --no-startup-id sh -c 'systemctl --user import-environment DISPLAY XAUTHORITY; systemctl --user start picom.service picom-power-watch.service'
exec_always --no-startup-id sh -c 'command -v copyq >/dev/null && copyq --start-server'
exec_always --no-startup-id sh -c 'bash /home/coisini/.config/i3/display/hotplug-watch.sh >/tmp/display-hotplug-watch.log 2>&1 &'
exec_always --no-startup-id sh -c 'bash /home/coisini/.config/i3/display/routing.sh auto --reload-if-changed >/tmp/workspace-routing.log 2>&1 &'
exec_always --no-startup-id /home/coisini/.local/bin/autotiling
exec_always --no-startup-id bash /home/coisini/.config/polybar/launch.sh
exec_always --no-startup-id /home/coisini/.config/i3/tray.sh

exec_always --no-startup-id sh -c 'pkill -x dunst >/dev/null 2>&1 || true'

bindsym $mod+Return exec $terminal
bindsym $mod+grave exec --no-startup-id bash /home/coisini/.config/i3/dropdown-terminal.sh
bindsym Mod1+space exec --no-startup-id $launcher
bindsym Ctrl+Mod1+space exec --no-startup-id $launcher
bindsym $mod+l exec --no-startup-id bash /home/coisini/.config/i3/lock.sh
bindsym $mod+q kill
bindsym $mod+Escape exec --no-startup-id bash /home/coisini/.config/i3/rofi/power.sh
bindsym Ctrl+grave exec --no-startup-id sh -c 'command -v copyq >/dev/null && copyq toggle'
bindcode --release $mod+Shift+39 exec --no-startup-id /usr/bin/flameshot gui
bindsym Print exec --no-startup-id /usr/bin/flameshot gui
bindsym Shift+Print exec --no-startup-id /usr/bin/flameshot full
bindsym Ctrl+Print exec --no-startup-id /usr/bin/flameshot screen -r

bindsym XF86AudioMute        exec --no-startup-id amixer sset Master toggle
bindsym XF86AudioLowerVolume exec --no-startup-id amixer sset Master 5%-
bindsym XF86AudioRaiseVolume exec --no-startup-id amixer sset Master 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set 5%+

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Ctrl+h split h
bindsym $mod+Ctrl+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

bindsym $mod+1 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 1
bindsym $mod+2 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 2
bindsym $mod+3 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 3
bindsym $mod+4 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 4
bindsym $mod+5 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 5
bindsym $mod+6 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 6
bindsym $mod+7 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 7
bindsym $mod+8 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 8
bindsym $mod+9 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 9
bindsym $mod+0 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 10

bindsym Ctrl+Mod1+1 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 1
bindsym Ctrl+Mod1+2 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 2
bindsym Ctrl+Mod1+3 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 3
bindsym Ctrl+Mod1+4 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 4
bindsym Ctrl+Mod1+5 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh external 5
bindsym Ctrl+Mod1+6 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 6
bindsym Ctrl+Mod1+7 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 7
bindsym Ctrl+Mod1+8 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 8
bindsym Ctrl+Mod1+9 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 9
bindsym Ctrl+Mod1+0 exec --no-startup-id bash /home/coisini/.config/i3/display/switch-fixed-output.sh internal 10


bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


bindsym $mod+Mod1+Left resize shrink width 10 px or 10 ppt
bindsym $mod+Mod1+Right resize grow width 10 px or 10 ppt
bindsym $mod+Mod1+Up resize shrink height 10 px or 10 ppt
bindsym $mod+Mod1+Down resize grow height 10 px or 10 ppt

mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes, exit i3' 'i3-msg exit'"
bindsym $mod+Ctrl+b exec --no-startup-id bash /home/coisini/.config/i3/theme-switcher.sh menu

