configuration {
    show-icons: false;
    modi: "dmenu";
    font: "JetBrainsMono Nerd Font Mono 11";
}

* {
    bg:         #f5ebe1;   /* 奶白 — 面板底 */
    bg-card:    #dcd3ca;   /* 米色 — 卡片 */
    bg-sel:     #1a1a1a;   /* 墨 — 选中底 */
    fg:         #1a1a1a;   /* 墨 — 主文字 */
    fg-dim:     #6a6258;   /* 暗前景 — 次要 */
    fg-sel:     #f5ebe1;   /* 选中文字(奶白) */
    accent:     #ca7081;   /* 强调粉 */
    red:        #ca7081;   /* 紧急 = 强调粉 */
    border-c:   #1a1a1a;   /* 墨边/分隔 */

    background-color:   @bg;
    text-color:         @fg;
    separatorcolor:     @fg-dim;
}

window {
    width: 680px;
    transparency: "real";
    border: 3px;
    border-color: @border-c;
    border-radius: 0px 0px 16px 16px;
    background-color: @bg;
    location: north;
    y-offset: 0px;
    padding: 0px;
}

mainbox {
    spacing: 0px;
    padding: 0px;
    children: [ header, sep, listview ];
}

header {
    enabled: true;
    padding: 14px 20px 10px 20px;
    background-color: @bg;
    children: [ header-left, header-right ];
    orientation: horizontal;
}

header-left {
    expand: false;
    str: " Control Center";
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Mono 12";
    vertical-align: 0.5;
}

header-right {
    expand: false;
    str: "";
}

sep {
    enabled: true;
    height: 2px;
    margin: 0px 16px 8px 16px;
    background-color: @border-c;
}

listview {
    lines: 6;
    columns: 2;
    fixed-height: false;
    border: 0px;
    scrollbar: false;
    spacing: 6px;
    padding: 4px 16px 16px 16px;
    background-color: transparent;
}

element {
    padding: 10px 14px;
    border: 0px;
    border-radius: 10px;
    background-color: @bg-card;
    text-color: @fg;
    cursor: pointer;
    spacing: 8px;
}

element normal.urgent {
    text-color: @red;
}

element selected.normal {
    background-color: @bg-sel;
    text-color: @fg-sel;
}

element alternate.normal {
    background-color: @bg-card;
}

element-text {
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font Mono 11";
}
