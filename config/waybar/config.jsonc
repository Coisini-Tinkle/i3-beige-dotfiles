{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "modules-left": ["custom/menu", "wlr/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["battery", "network", "tray"],

  "custom/menu": {
    "format": "  󰣛  ",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "wlr/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "previous",
    "on-scroll-down": "next",
    "active-first": true,
    "format-icons": {
      "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V",
      "6": "VI", "7": "VII", "8": "VIII", "9": "IX", "10": "X"
    }
  },

  "clock": {
    "time": " %H:%M ",
    "tooltip-format": "%d-%m-%Y %H:%M",
    "format": " 󰅐 %H:%M  %d-%m-%Y "
  },

  "battery": {
    "interval": 60,
    "full-at": 98,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂆 {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "network": {
    "interval": 60,
    "format-wifi": " 󰤨 {essid} ",
    "format-ethernet": " 󰈀 {ifname} ",
    "format-disconnected": " 󰤭 off "
  },

  "tray": {
    "spacing": 4,
    "padding": 2
  }
}
